---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectTable from '../../components/ProjectTable.astro';
import headerImage from '../../assets/projects/rk-desai-colleges.jpg';
---

<BaseLayout
  title="Projects"
  description="Completed and ongoing road, civil, industrial, commercial and institutional projects delivered by AHT Construction across South Gujarat, Daman and Silvassa."
>
  <PageHeader
    eyebrow="Our Work"
    title="Projects"
    lead="Every project we have delivered and every one under way — filter by stage or type, and open any row for the full detail and photographs."
    image={headerImage}
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Projects' }]}
  />

  <section class="section bg-concrete">
    <div class="container-x">
      <ProjectTable />
    </div>
  </section>
</BaseLayout>
