---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';

/**
 * Privacy notice.
 *
 * Written from what the site actually does, not from a template: there is no
 * analytics script, no tag manager, no cookie of any kind, and no browser
 * storage anywhere in the build. The only personal data that exists is what
 * somebody types into the enquiry form. Every claim below was checked against
 * the source before it was written, and it must be re-checked if analytics or
 * embeds are ever added — an inaccurate privacy notice is worse than none.
 */
const updated = 'September 2026';

const sections = [
  {
    heading: 'What we collect',
    body: `Only what you type into the enquiry form on this site: your name, phone number, email address and your message. Nothing else about you is collected or inferred.`,
  },
  {
    heading: 'What we do with it',
    body: `We use it to answer your enquiry and to quote for the work you have asked about. We do not sell it, rent it, or share it with anyone outside our own office, and we do not send marketing to people who have not asked for it.`,
  },
  {
    heading: 'Cookies and tracking',
    body: `This site sets no cookies. There is no analytics, no advertising pixel, no tag manager and no social media tracker anywhere on it. Nothing about your visit is stored in your browser.`,
  },
  {
    heading: 'How the form is handled',
    body: `The enquiry form is processed by Netlify, the service that hosts this site, which passes the message to our office by email. It travels over an encrypted connection.`,
  },
  {
    heading: 'How long we keep it',
    body: `We keep enquiries for as long as we may reasonably need them for the project they relate to, and for our own business records afterwards. If you would rather we deleted yours, ask us and we will.`,
  },
  {
    heading: 'Seeing or deleting your details',
    body: `Write to us at the email address below and ask what we hold about you, ask for it to be corrected, or ask for it to be deleted. There is no charge, and you do not need a reason.`,
  },
];
---

<BaseLayout
  title="Privacy"
  description={`How ${site.legalName} handles the details you send through this website.`}
>
  <section class="bg-concrete pt-32 pb-16 md:pt-40 md:pb-20">
    <div class="container-x">
      <nav aria-label="Breadcrumb">
        <a href="/" class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-accent-700 hover:underline">
          Home
        </a>
        <span class="px-2 font-mono text-[0.7rem] text-stone-600">/</span>
        <span class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-stone-600">Privacy</span>
      </nav>

      <h1 class="statement mt-7 max-w-3xl text-ink-950">Privacy notice</h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-stone-700">
        Short, because there is not much to say. This site sets no cookies and tracks nobody. The
        only details we hold are the ones you choose to send us.
      </p>

      <p class="mt-6 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-stone-600">
        Last updated {updated}
      </p>
    </div>
  </section>

  <section class="section border-t-2 border-hairline bg-concrete">
    <div class="container-x">
      <dl class="max-w-3xl border-t border-hairline" data-reveal-group>
        {
          sections.map((item) => (
            <div class="border-b border-hairline py-8" data-reveal>
              <dt class="font-display text-xl text-ink-950">{item.heading}</dt>
              <dd class="mt-3 text-base leading-relaxed text-stone-700">{item.body}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-12 max-w-3xl">
        <p class="index-label">Ask us anything about this</p>
        <div class="mt-5 flex flex-wrap gap-4">
          <a href={`mailto:${site.email}`} class="btn btn-primary max-w-full [overflow-wrap:anywhere]">
            <Icon name="mail" class="h-5 w-5" />
            {site.email}
          </a>
          <a href={site.phoneHref} class="btn btn-outline-dark">
            <Icon name="phone" class="h-5 w-5" />
            {site.phone}
          </a>
        </div>

        <p class="mt-10">
          <a href="/" class="link-arrow text-sm">
            Back to home
            <Icon name="arrowRight" class="h-4 w-4" />
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
