---
import SectionHeading from './SectionHeading.astro';
import ProcessIllustration from './ProcessIllustration.astro';

const steps = [
  {
    art: 'survey' as const,
    title: 'Site Survey & Measurement',
    body: 'We visit the site, take levels and confirm access, existing services and working hours.',
  },
  {
    art: 'estimate' as const,
    title: 'Estimation & Quotation',
    body: 'You receive a rate-wise estimate against the drawings or tender documents, item by item.',
  },
  {
    art: 'execute' as const,
    title: 'Execution',
    body: 'Our plant, fleet and site team deliver the works in agreed stages with quality checks at each layer.',
  },
  {
    art: 'handover' as const,
    title: 'Handover & Billing',
    body: 'Final measurement, joint inspection and documentation completed for your records and payment.',
  },
];
---

<section id="process" class="section scroll-mt-24 bg-mist-50">
  <div class="container-x">
    <SectionHeading
      eyebrow="How We Work"
      title="A clear process, start to finish"
      lead="Every project runs through the same four stages, so you always know where things stand."
      meta="Four stages"
    />

    <!-- Each stage gets its own drawn, animated panel. -->
    <ol class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {
        steps.map((step, index) => (
          <li
            class="group flex flex-col rounded-2xl bg-white p-6 ring-1 ring-ink-950/5 transition-all duration-300 hover:-translate-y-1 hover:ring-amber-500"
            data-reveal
          >
            <div class="rounded-xl bg-white p-4 ring-1 ring-ink-950/5">
              <ProcessIllustration step={step.art} />
            </div>

            <div class="mt-6 flex items-center gap-3">
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-50 border border-accent-100 text-accent-600 font-display text-base font-bold text-ink-950 tabular-nums"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              <h3 class="text-xl leading-tight text-ink-950">{step.title}</h3>
            </div>

            <p class="mt-3 text-base leading-relaxed text-stone-600">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
