---
import SectionHeading from './SectionHeading.astro';
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

/**
 * Registrations & compliance — the procurement qualification block.
 *
 * This exists because the `certifications` collection was editable in /admin
 * but only its `title` ever reached a page (as a chip inside ProofOfDelivery).
 * Anything the owner typed into `issuer`, `reference` or `summary` rendered
 * nowhere. This section is where those fields land.
 *
 * Two layouts, chosen by how much detail has actually been entered:
 *
 *   - Nothing filled in yet  → a hard-ruled tile grid of titles. Compact and
 *     deliberate: four short lines in a register, the same treatment as the
 *     proof blocks above.
 *   - Any detail present     → a full row per credential, with the issuer,
 *     the summary and the reference number in their own columns.
 *
 * The switch matters because a 12-column row carrying only a title leaves
 * two-thirds of the width empty, which reads as a broken section rather than
 * as a short one. Either way no field is ever faked: a blank stays hidden.
 */
const certifications = (await getCollection('certifications')).sort(
  (a, b) => a.data.order - b.data.order,
);

const hasDetail = certifications.some(
  (c) => c.data.issuer || c.data.summary || c.data.reference,
);
---

{
  certifications.length > 0 && (
    <section id="credentials" class="section scroll-mt-24 border-t-2 border-hairline bg-mist-50">
      <div class="container-x">
        <SectionHeading
          eyebrow="Credentials"
          title="Registered, and on record"
          lead="The registrations a tender committee checks before it scores a bid — held current at the office and listed here as they stand."
        />

        {hasDetail ? (
          /* A register: one hairline-separated row per credential, so the block
             reads as a document rather than as another feature grid. */
          <ul class="mt-12 border-t border-hairline" data-reveal-group>
            {certifications.map((cert) => (
              <li
                class="grid grid-cols-1 gap-x-8 gap-y-3 border-b border-hairline py-7 md:grid-cols-12 md:items-baseline"
                data-reveal
              >
                <div class="flex items-start gap-3.5 md:col-span-5">
                  <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center bg-accent-50 border border-accent-100 text-accent-600">
                    <Icon name={cert.data.icon} class="h-5 w-5" strokeWidth={1.5} />
                  </span>
                  <div class="min-w-0">
                    <h3 class="font-display text-xl leading-tight text-ink-950">
                      {cert.data.title}
                    </h3>
                    {cert.data.issuer && (
                      <p class="mt-1 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-accent-700">
                        {cert.data.issuer}
                      </p>
                    )}
                  </div>
                </div>

                {cert.data.summary && (
                  <p class="text-base leading-relaxed text-stone-700 md:col-span-4">
                    {cert.data.summary}
                  </p>
                )}

                {/* Reference numbers set in mono and right-aligned on desktop,
                    so the column scans like a list of document numbers. */}
                {cert.data.reference && (
                  <p class="font-mono text-sm tracking-wide text-ink-950 md:col-span-3 md:text-right">
                    {cert.data.reference}
                  </p>
                )}
              </li>
            ))}
          </ul>
        ) : (
          /* Titles only. Hard-ruled tiles, gap-px over an ink ground — the same
             register treatment as the proof blocks, so a short section still
             reads as designed. */
          <ul
            class="mt-12 grid gap-px rounded-xl border border-hairline bg-hairline overflow-hidden sm:grid-cols-2 lg:grid-cols-4"
            data-reveal-group
          >
            {certifications.map((cert) => (
              <li class="spot flex items-center gap-3.5 bg-concrete p-6" data-reveal>
                <span class="flex h-10 w-10 shrink-0 items-center justify-center bg-accent-50 border border-accent-100 text-accent-600">
                  <Icon name={cert.data.icon} class="h-5 w-5" strokeWidth={1.5} />
                </span>
                <h3 class="font-display text-lg leading-tight text-ink-950">{cert.data.title}</h3>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}
