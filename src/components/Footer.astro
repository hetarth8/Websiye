---
import site from '../data/site.json';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const whatsappHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`;
const year = new Date().getFullYear();

const services = [
  'Asphalt Road Work',
  'Bituminous Surfacing',
  'RCC & Civil Works',
  'Industrial Infrastructure',
  'Site Development',
];
---

<footer class="bg-mist-100 text-ink-950">
  <div class="container-x py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div>
        <Logo tone="dark" />
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-stone-600">
          {site.description}
        </p>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary mt-7 !min-h-11 !px-5 !text-sm"
        >
          <Icon name="whatsapp" class="h-4 w-4" />
          Message on WhatsApp
        </a>
      </div>

      <nav aria-labelledby="footer-nav-heading">
        <h2
          id="footer-nav-heading"
          class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-accent-700"
        >
          Explore
        </h2>
        <ul class="mt-3">
          {
            site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-flex min-h-11 items-center text-sm text-stone-600 transition-colors hover:text-accent-700"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-accent-700">
          Capabilities
        </h2>
        <ul class="mt-5 space-y-3">
          {services.map((service) => <li class="text-sm text-stone-600">{service}</li>)}
        </ul>
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-accent-700">
          Get in touch
        </h2>
        <address class="mt-5 space-y-4 not-italic">
          <p class="flex gap-3 text-sm text-stone-600">
            <Icon name="pin" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" />
            <span>
              {site.address.line1}<br />
              {site.address.line2}<br />
              {site.address.city} – {site.address.postalCode}, {site.address.state}
            </span>
          </p>
          {/* The anchor wraps its icon so the whole row is one 44px target. */}
          <a
            href={site.phoneHref}
            class="flex min-h-11 items-center gap-3 text-sm text-stone-600 transition-colors hover:text-accent-700"
          >
            <Icon name="phone" class="h-5 w-5 shrink-0 text-accent-600" />
            {site.phone}
          </a>
          <a
            href={`mailto:${site.email}`}
            class="flex min-h-11 items-center gap-3 break-all text-sm text-stone-600 transition-colors hover:text-accent-700"
          >
            <Icon name="mail" class="h-5 w-5 shrink-0 text-accent-600" />
            {site.email}
          </a>
        </address>
      </div>
    </div>
  </div>

  <div class="border-t border-hairline">
    <div
      class="container-x pb-safe flex flex-col gap-3 pt-6 text-xs text-stone-600 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.legalName}. All rights reserved.</p>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a href="/privacy" class="transition-colors hover:text-accent-700">Privacy</a>
        <span aria-hidden="true" class="text-ink-950/45">&middot;</span>
        <span>{site.address.city}, {site.address.state}</span>
      </p>
    </div>
  </div>
</footer>
