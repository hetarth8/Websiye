---
import site from '../data/site.json';
import Icon from './Icon.astro';

/**
 * The qualification strip a procurement office reads first.
 *
 * It was a full-bleed band of saturated crimson. The owner's note was that the
 * red is "too flashy", and they were right for the same reason the amber band
 * was wrong: a 100%-saturation hue across the full measure stops being an
 * accent and becomes a poster. It is now the same brushed steel as the rest of
 * the structural furniture, so the strip states its facts instead of shouting
 * them, and the amber ticks are the only colour on it.
 *
 * The marquee is not decoration. The five items do not fit a phone, so this
 * strip used to require a horizontal SWIPE that nothing signalled — most
 * visitors would only ever have seen the first two. Below the breakpoint the
 * track now drifts on its own, slowly, and the list is duplicated so the loop
 * has no seam. Above it, everything fits and nothing moves.
 *
 * The duplicate is aria-hidden, so a screen reader is told each credential
 * once. Motion is disabled outright under prefers-reduced-motion, where the
 * strip falls back to a normal scrollable list.
 */
const gstStates = site.registration.gst.map((g) => g.state).join(' · ');

const credentials = [
  'Government-approved contractor',
  `GST-registered — ${gstStates}`,
  'Own quarries, ready-mix & asphalt plants',
  '300+ engineers on staff',
  `Operating since ${site.founded}`,
];
---

<section class="ribbon" aria-label="Credentials">
  <div class="ribbon__viewport">
    <ul class="ribbon__track">
      {
        credentials.map((c) => (
          <li class="ribbon__item">
            <Icon name="shieldCheck" class="h-4 w-4 shrink-0 text-accent-600" strokeWidth={1.5} />
            <span>{c}</span>
          </li>
        ))
      }
    </ul>

    {/* The seamless half. Hidden from assistive tech and from the static
        desktop layout — it exists only so the drift can loop. */}
    <ul class="ribbon__track ribbon__track--clone" aria-hidden="true">
      {
        credentials.map((c) => (
          <li class="ribbon__item">
            <Icon name="shieldCheck" class="h-4 w-4 shrink-0 text-accent-600" strokeWidth={1.5} />
            <span>{c}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Was a full-bleed dark slab. It is a strip of LABELS, so it is now a very
     light blue band: obsidian type on accent-50 is 15.97:1, and hairlines top
     and bottom are what separate it from the white page (the tint alone is
     only 1.12:1). */
  .ribbon {
    background-color: var(--color-accent-50);
    border-top: 1px solid var(--color-accent-100);
    border-bottom: 1px solid var(--color-accent-100);
    color: var(--color-ink-950);
    overflow: hidden;
  }

  .ribbon__viewport {
    display: flex;
    width: 100%;
  }

  .ribbon__track {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin: 0;
    padding: 0.85rem 1.5rem;
    list-style: none;
    flex-shrink: 0;
  }

  .ribbon__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  /* --- phones: the list does not fit, so it drifts ----------------------- */
  @media (max-width: 63.999rem) {
    .ribbon__track {
      animation: ribbon-drift 42s linear infinite;
    }

    .ribbon:hover .ribbon__track,
    .ribbon:focus-within .ribbon__track {
      animation-play-state: paused;
    }
  }

  /* --- desktop: it all fits, so nothing moves --------------------------- */
  @media (min-width: 64rem) {
    .ribbon__viewport {
      justify-content: center;
    }

    .ribbon__track {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem 2rem;
      flex-shrink: 1;
    }

    .ribbon__track--clone {
      display: none;
    }
  }

  @keyframes ribbon-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  /* A strip that moves by itself is exactly what reduced-motion is for. */
  @media (prefers-reduced-motion: reduce) {
    .ribbon__track {
      animation: none;
    }

    .ribbon__viewport {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .ribbon__viewport::-webkit-scrollbar {
      display: none;
    }

    .ribbon__track--clone {
      display: none;
    }
  }
</style>
