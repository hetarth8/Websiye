---
/**
 * Inline SVG icon set — no emoji, no icon font, no network request.
 *
 * Stroke icons follow the Lucide geometry (24×24, 1.5px stroke, round caps);
 * `whatsapp` and `play` are solid shapes so they are flagged separately.
 * Icons are decorative by default and hidden from assistive tech; pass a
 * `title` only when the icon is the sole label for a control.
 */
interface Props {
  name: keyof typeof ICONS;
  class?: string;
  /** Accessible name. Omit for decorative icons sitting next to visible text. */
  title?: string;
  strokeWidth?: number;
  /** Any other attribute (data-*, id, …) is forwarded to the <svg>. */
  [key: string]: unknown;
}

const ICONS = {
