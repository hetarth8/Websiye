const { name, class: className = 'h-6 w-6', title, strokeWidth = 1.5, ...rest } = Astro.props;

const icon = ICONS[name];
const solid = 'solid' in icon && icon.solid;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={className}
  fill={solid ? 'currentColor' : 'none'}
  stroke={solid ? 'none' : 'currentColor'}
  stroke-width={solid ? undefined : strokeWidth}
  stroke-linecap={solid ? undefined : 'round'}
  stroke-linejoin={solid ? undefined : 'round'}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  {...rest}
>
  {title && <title>{title}</title>}
  {icon.paths.map((d) => <path d={d} />)}
</svg>
