{
  // The backend is Node ESM, not an Astro bundle, so it needs its own compiler
  // settings rather than the site's. `NodeNext` is what makes the explicit `.js`
  // import extensions throughout server/ correct rather than decorative — they
  // are what Node actually resolves at runtime.
  "include": ["server/**/*", "netlify/**/*", "tests/**/*", "scripts/**/*.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist", ".storage", "tests/web"],
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
