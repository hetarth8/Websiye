# =============================================================================
# AHT Construction — environment configuration
#
# Copy to `.env` and fill in. NEVER commit `.env` — it is in .gitignore.
# On Netlify these are set under Site configuration → Environment variables.
# =============================================================================

# --- application -------------------------------------------------------------
# development | staging | production
NODE_ENV=development

# Canonical public origin. Used for canonical URLs, sitemap, robots.txt, JSON-LD,
# cookie domain and CORS. On Netlify, URL/DEPLOY_PRIME_URL are injected
# automatically and SITE_URL only needs setting to pin a custom domain.
SITE_URL=http://localhost:4321

# --- database ----------------------------------------------------------------
# Neon Postgres connection string (free tier).
#   https://console.neon.tech → project → Connection string → "Pooled connection"
# Must include `?sslmode=require`.
# NOTE: the free tier suspends an idle database; the first query after idle can
# take a few seconds. Build-time reads are written to tolerate this.
DATABASE_URL=postgresql://user:password@host.neon.tech/aht?sslmode=require

# Used ONLY by `npm run db:migrate` and tests. Point at a separate database —
# the test suite truncates tables.
DATABASE_URL_TEST=postgresql://user:password@host.neon.tech/aht_test?sslmode=require

# --- authentication ----------------------------------------------------------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotating this invalidates every active session.
SESSION_SECRET=

# How long a signed-in session stays valid, in hours.
SESSION_TTL_HOURS=12

# --- file storage ------------------------------------------------------------
# local | netlify-blobs | s3
# `local` writes to ./.storage and is for development only.
STORAGE_DRIVER=netlify-blobs

# Only required when STORAGE_DRIVER=s3 (S3, R2, or any S3-compatible service).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN origin that fronts the bucket; falls back to the bucket URL.
S3_PUBLIC_BASE_URL=

# --- email (enquiry notifications) -------------------------------------------
# Leave blank to disable outbound email; enquiries are still stored and visible
# in the admin dashboard. Nothing is silently dropped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Where new enquiry notifications are sent.
ENQUIRY_NOTIFY_TO=

# --- limits ------------------------------------------------------------------
# Public enquiry submissions allowed per IP per hour.
RATE_LIMIT_ENQUIRY_PER_HOUR=5
# Failed sign-in attempts before the account locks.
AUTH_MAX_FAILED_ATTEMPTS=5
# How long an account stays locked, in minutes.
AUTH_LOCKOUT_MINUTES=15
# Largest accepted upload, in megabytes.
UPLOAD_MAX_MB=10

# --- logging -----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
